  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ApricotFramework.ErrorDefinitions/ApricotFramework.ErrorDefinitions.csproj" />
  </ItemGroup>

</Project>
